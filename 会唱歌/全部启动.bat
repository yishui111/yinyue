@echo off
chcp 936 >nul
rem ============================================================
rem  一键启动「会唱歌」全部服务：
rem    1. 唱歌工作台   http://127.0.0.1:8102  （填词/合成/换声）
rem    2. 训练工作台   http://127.0.0.1:8103  （训练自己的音色）
rem  停止：双击 全部停止.bat
rem ============================================================
cd /d "%~dp0"
title 会唱歌 全部启动
start "唱歌工作台 8102" cmd /c "启动.bat"
timeout /t 2 >nul
start "训练工作台 8103" cmd /c "训练\启动.bat"
echo.
echo 两个服务已在各自窗口启动：
echo   唱歌工作台  http://127.0.0.1:8102
echo   训练工作台  http://127.0.0.1:8103
echo （关掉对应窗口或用 全部停止.bat 即可停止）
pause
